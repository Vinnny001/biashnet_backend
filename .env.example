PORT=5000
NODE_ENV=development

# JWT (issued by src/utils/jwt.js, verified by payment/biashnet-mpesa-api's
# utils/backendJwt.js — BOTH services must use the exact same value).
#
# IMPORTANT: this MUST be a long random secret, never left blank or set to
# any placeholder text. jwt.js falls back to the literal string
# "replace_with_a_long_random_secret" when this is unset — that fallback
# is visible in the source code, so leaving it unset lets anyone forge a
# valid login token for any user (including admin) with zero credentials.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=

# Brevo (transactional email — OTP codes, password reset links)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload server integration — shared key checked by
# routes/auth.routes.js verify-upload / upload-server's uploadAuth.js
UPLOAD_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=

# Frontend origin (CORS / password reset link base, etc.)
CLIENT_URL=

# Not currently referenced anywhere in src/ — confirm before relying on it
PAYMENT_PROVIDER_KEY=
